//@version=5
indicator("Half Gap Liquidity Indicator [Multi-Asset]", overlay=true, shorttitle="Half Gap MA")

// =============================================================================
// 1. INPUTS
// =============================================================================

// --- Asset Type Detection ---
grp_asset = "Asset Configuration"
asset_type = input.string("Auto-Detect", "Asset Type", options=["Auto-Detect", "Stocks/ETF", "Forex", "Crypto", "Futures", "Gold/Metals", "Energy", "Indices"], group=grp_asset, tooltip="Auto-detect will attempt to identify asset type. Manual selection overrides.")

// --- Session Settings ---
grp_session = "Session Settings"
use_auto_settings = input.bool(true, "Use Optimized Defaults", group=grp_session, tooltip="If enabled, ignores manual session inputs below and uses optimized settings for the detected asset.")
session_start = input.session("0930-1600", "Trading Session (NY Time)", group=grp_session, tooltip="Manual Override: Stocks: 0930-1600 | Forex: 1700-1700")
time_zone     = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "UTC"], group=grp_session)
use_reg_hours = input.bool(true, "Use Regular Hours Only", group=grp_session, tooltip="Filters logic to apply only within specified session. Disable for 24hr markets.")

// Custom daily reset time for 24hr markets
custom_reset_hour = input.int(17, "Daily Reset Hour (24hr markets)", minval=0, maxval=23, group=grp_session, tooltip="For Forex/Crypto: Hour when 'new day' starts (e.g., 17 = 5 PM NY rollover)")

// --- Visual Settings ---
grp_visual = "Visual Settings"
color_upper   = input.color(color.green, "Upper Boundary Color", group=grp_visual)
color_lower   = input.color(color.red, "Lower Boundary Color", group=grp_visual)
color_hg      = input.color(color.white, "Half Gap Color", group=grp_visual)
color_fill_up = input.color(color.new(color.green, 90), "Zone Fill (Bullish Gap)", group=grp_visual)
color_fill_dn = input.color(color.new(color.red, 90), "Zone Fill (Bearish Gap)", group=grp_visual)
color_fill_fl = input.color(color.new(color.gray, 90), "Zone Fill (Flat)", group=grp_visual)

show_labels   = input.bool(true, "Show Price Labels", group=grp_visual)
show_table    = input.bool(true, "Show Info Panel", group=grp_visual)
show_zones    = input.bool(true, "Show Half Gap Zone", group=grp_visual, tooltip="Highlight band around Half Gap")
zone_width_input = input.float(0.15, "Half Gap Zone Width (%)", minval=0.05, maxval=1.0, step=0.05, group=grp_visual) / 100
label_offset_input = input.int(5, "Label Horizontal Offset (bars)", minval=0, group=grp_visual)

// Line break behavior
break_lines   = input.bool(true, "Break Lines at Session Change", group=grp_visual, tooltip="If enabled, lines will visually disconnect between sessions")

// --- Calculation Settings ---
grp_calc = "Calculation Settings"
vol_len       = input.int(20, "Volume MA Length", minval=1, group=grp_calc)
tol_pct       = input.float(0.01, "Position Tolerance (%)", minval=0.0, step=0.01, group=grp_calc) / 100
min_gap_pct   = input.float(0.05, "Minimum Gap % for Signals", minval=0.0, step=0.05, group=grp_calc, tooltip="Gaps smaller than this % are considered FLAT (no signal)")

// --- Resilience (Market Bias) Settings ---
grp_res = "Resilience & Logic"
resilience_mode = input.string("SPY Proxy (Internal)", "Resilience Source", options=["SPY Proxy (Internal)", "External Symbol", "External Indicator (Source)", "None"], group=grp_res, tooltip="Source for market-wide bias.")
res_symbol      = input.symbol("SPY", "External Resilience Symbol", group=grp_res)
res_source      = input.source(close, "External Resilience Source", group=grp_res)

// --- Volume & Logic Settings ---
vol_spike_mult  = input.float(1.5, "Volume Spike Multiplier", minval=1.0, step=0.1, group=grp_res)
vol_key_only    = input.bool(true, "Check Vol at Key Levels Only", group=grp_res)

// --- Trend Configuration ---
trend_atr_len   = input.int(14, "ATR Length for Targets", minval=1, group=grp_res)
trend_atr_mult  = input.float(3.0, "ATR Multiplier for Trend Target", minval=0.5, step=0.1, group=grp_res)

// =============================================================================
// 2. ASSET TYPE DETECTION
// =============================================================================

detect_asset_type() =>
    string detected = "Stocks/ETF"
    string ticker = syminfo.ticker
    string type = syminfo.type
    string root = syminfo.root

    if asset_type != "Auto-Detect"
        detected := asset_type
    else
        if type == "forex" or str.length(ticker) == 6
            detected := "Forex"
        else if type == "crypto" or str.contains(ticker, "BTC") or str.contains(ticker, "ETH") or str.contains(ticker, "USDT")
            detected := "Crypto"
        else if str.contains(ticker, "GC") or str.contains(ticker, "XAU") or ticker == "GOLD" or str.contains(ticker, "SI")
            detected := "Gold/Metals"
        else if str.contains(ticker, "CL") or str.contains(ticker, "NG") or str.contains(ticker, "RB") or str.contains(ticker, "HO")
            detected := "Energy"
        // Prioritize indices/futures roots
        else if str.contains(root, "ES") or str.contains(root, "NQ") or str.contains(root, "YM") or str.contains(root, "RTY") or str.contains(ticker, "SPX") or str.contains(ticker, "NDX") or str.contains(ticker, "US30")
            detected := "Indices"
        else if type == "futures" or str.contains(ticker, "!")
            detected := "Futures"
        else
            detected := "Stocks/ETF"
    detected

current_asset_type = detect_asset_type()

// --- Optimization Logic ---
get_optimized_params(type) =>
    string s = session_start
    int r = custom_reset_hour
    float g = min_gap_pct
    float z = zone_width_input

    if use_auto_settings
        if type == "Forex"
            s := "1700-1700"
            r := 17
            g := 0.15
            z := 0.001
        else if type == "Crypto"
            s := "0000-0000"
            r := 0
            g := 0.5
            z := 0.005
        else if type == "Gold/Metals" or type == "Energy" or type == "Futures"
            s := "1800-1700"
            r := 17
            g := 0.1
            z := 0.002
        else if type == "Indices"
            s := "1700-1700"
            r := 17
            g := 0.05
            z := 0.0015
        else // Stocks
            s := "0930-1600"
            r := 17
            g := 0.05
            z := 0.0015
    [s, r, g, z]

[opt_session, opt_reset, opt_gap, opt_zone] = get_optimized_params(current_asset_type)

// =============================================================================
// 3. DATA & SESSION LOGIC
// =============================================================================

// Detect New Day (Time-Shifted Logic)
detect_new_day(asset_type_param) =>
    bool new_day_flag = false
    is_24h = asset_type_param == "Forex" or asset_type_param == "Crypto" or asset_type_param == "Futures" or asset_type_param == "Gold/Metals" or asset_type_param == "Energy" or asset_type_param == "Indices"

    if is_24h
        // Shift time back by reset hour to calculate "business day"
        time_offset = time - (opt_reset * 3600 * 1000)
        adjusted_day = dayofmonth(time_offset, time_zone)
        prev_adjusted_day = dayofmonth(time_offset[1], time_zone)
        new_day_flag := adjusted_day != prev_adjusted_day
    else
        new_day_flag := ta.change(time("D")) != 0
    new_day_flag

is_new_day = detect_new_day(current_asset_type)

// Session Filtering
is_in_session(sess_str) => not na(time(timeframe.period, sess_str, time_zone))
is_24h_asset = current_asset_type != "Stocks/ETF"
should_use_reg_hours = use_reg_hours and not (use_auto_settings and is_24h_asset)
in_session = should_use_reg_hours ? is_in_session(opt_session) : true

// Daily Data Acquisition (Global Scope to prevent errors)
// We use ignore_invalid_symbol to prevent crashes on obscure assets
d_open_req = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
d_close_prev_req = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

cdo = d_open_req
pdc = d_close_prev_req
valid_data = not na(cdo) and not na(pdc) and cdo > 0 and pdc > 0

// Session State Management
var float session_pdc = na
var float session_cdo = na
var float session_hg = na
var int session_start_bar = na
var int session_gap_dir = 0
var float session_upper_b = na
var float session_lower_b = na
var float session_gap_mag = na

if (is_new_day and valid_data) or (na(session_pdc) and valid_data)
    session_pdc := pdc
    session_cdo := cdo
    session_hg := (pdc + cdo) / 2
    session_start_bar := bar_index
    session_gap_dir := cdo > pdc ? 1 : (cdo < pdc ? -1 : 0)
    session_upper_b := math.max(pdc, cdo)
    session_lower_b := math.min(pdc, cdo)
    session_gap_mag := math.abs(cdo - pdc)

// Override flat gap
gap_pct = (session_gap_mag / session_pdc) * 100
if gap_pct < opt_gap
    session_gap_dir := 0

// =============================================================================
// 4. RESILIENCE CALCULATION
// =============================================================================

// Fetch external data globally
[spy_d_open, spy_d_close1] = request.security("SPY", "D", [open, close[1]], lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
spy_cur_close = request.security("SPY", timeframe.period, close, ignore_invalid_symbol=true)
ext_sym_close = request.security(res_symbol, timeframe.period, close, ignore_invalid_symbol=true)

// Calculate Bias
get_resilience_bias(mode, spy_o, spy_cp, spy_c, ext_sym, ext_src) =>
    int rb = 0
    if mode == "SPY Proxy (Internal)"
        spy_hg = (spy_o + spy_cp) / 2
        if not na(spy_hg) and not na(spy_c)
            rb := spy_c > spy_hg ? 1 : -1
    else if mode == "External Symbol"
        if not na(ext_sym)
            rb := ext_sym > 0 ? 1 : -1
    else if mode == "External Indicator (Source)"
        if not na(ext_src)
            rb := ext_src > 0 ? 1 : -1
    rb

res_bias_val_raw = get_resilience_bias(resilience_mode, spy_d_open, spy_d_close1, spy_cur_close, ext_sym_close, res_source)

// Invert Resilience for Gold/Metals (inverse correlation with equities)
bool invert_res = current_asset_type == "Gold/Metals"
int res_bias_val = invert_res ? -res_bias_val_raw : res_bias_val_raw

res_bias_str = res_bias_val == 1 ? "BULLISH" : (res_bias_val == -1 ? "BEARISH" : "NEUTRAL")

// =============================================================================
// 5. ZONE STATE & SIGNALS
// =============================================================================

// Touch Detection
touch_tol = session_pdc * 0.0005 // 0.05%
is_touch_upper = math.abs(high - session_upper_b) <= touch_tol or (high >= session_upper_b and low <= session_upper_b)
is_touch_lower = math.abs(high - session_lower_b) <= touch_tol or (high >= session_lower_b and low <= session_lower_b)
is_touch_hg    = math.abs(high - session_hg) <= touch_tol or (high >= session_hg and low <= session_hg)
is_key_touch   = is_touch_upper or is_touch_lower or is_touch_hg

// Volume Analysis
vol_sma = ta.sma(volume, vol_len)
is_vol_spike = volume > (vol_sma * vol_spike_mult)
valid_vol_activity = is_vol_spike and (vol_key_only ? is_key_touch : true)

// Momentum Logic
is_bull_mom = close > open and close > close[1]
is_bear_mom = close < open and close < close[1]

// State Machine
var string zone_state = "ACTIVE"

if is_new_day
    zone_state := "ACTIVE"

if is_key_touch and not is_new_day
    if valid_vol_activity
        zone_state := "ACTIVE"
    else if barstate.isconfirmed
        zone_state := "EXHAUSTED"

// Trend Mode Check (Stale Zone)
dist_pct = math.abs(close - session_hg) / session_hg
if dist_pct > 0.05
    zone_state := "TRENDING"

// Global Technicals (Must be calculated every bar)
atr_val = ta.atr(trend_atr_len)
ema20 = ta.ema(close, 20)

// Position Logic
hg_tol_pos = session_hg * tol_pct
var int pos_state = 0 // 1=Above, -1=Below
if close > (session_hg + hg_tol_pos)
    pos_state := 1
else if close < (session_hg - hg_tol_pos)
    pos_state := -1
else
    pos_state := 0

// Signal Generation
var string signal_bias = "NEUTRAL"
var float signal_target = na
var string conf_level = "LOW"

if zone_state == "ACTIVE"
    // Scalp Mode
    if res_bias_val == 1 // Resilience Bullish -> Buy dips
        signal_bias := "LONG SCALP"
        signal_target := session_upper_b
        conf_level := pos_state >= 0 ? "HIGH" : "MED"
    else if res_bias_val == -1 // Resilience Bearish -> Short rips
        signal_bias := "SHORT SCALP"
        signal_target := session_lower_b
        conf_level := pos_state <= 0 ? "HIGH" : "MED"
    else
        signal_bias := "NEUTRAL (Range)"
        signal_target := na
        conf_level := "LOW"
else if zone_state == "EXHAUSTED"
    // Breakout Mode
    if res_bias_val == 1
        signal_bias := "BULLISH BREAKOUT"
        signal_target := session_upper_b + (session_upper_b - session_lower_b)
        conf_level := "HIGH"
    else if res_bias_val == -1
        signal_bias := "BEARISH BREAKDOWN"
        signal_target := session_lower_b - (session_upper_b - session_lower_b)
        conf_level := "HIGH"
    else
        signal_bias := "WAITING"
        signal_target := na
        conf_level := "LOW"
else // TRENDING
    // Dynamic Targets & Trend Strength
    if res_bias_val == 1 and is_bull_mom
        // Strong trend if above EMA20
        is_strong = close > ema20
        signal_bias := is_strong ? "STRONG BULLISH TREND" : "BULLISH TREND"
        signal_target := close + (atr_val * trend_atr_mult)
        conf_level := is_strong ? "HIGH" : "MED"

    else if res_bias_val == -1 and is_bear_mom
        // Strong trend if below EMA20
        is_strong = close < ema20
        signal_bias := is_strong ? "STRONG BEARISH TREND" : "BEARISH TREND"
        signal_target := close - (atr_val * trend_atr_mult)
        conf_level := is_strong ? "HIGH" : "MED"

    else
        signal_bias := "TRENDING"
        signal_target := na
        conf_level := "LOW"

// =============================================================================
// 6. VISUALIZATION
// =============================================================================

display_condition = (use_reg_hours ? in_session : true) and not na(session_pdc)

// Line Break Logic (Using Color Transparency)
is_start_bar = bar_index == session_start_bar
transp_val = break_lines and is_start_bar ? 100 : 0

// Colors
c_pdc_final = color.new(session_pdc == session_upper_b ? color_upper : color_lower, transp_val)
c_cdo_final = color.new(session_cdo == session_upper_b ? color_upper : color_lower, transp_val)
c_hg_final  = color.new(color_hg, transp_val)

// Plots
p_pdc = plot(display_condition ? session_pdc : na, "PDC", color=c_pdc_final, linewidth=1)
p_cdo = plot(display_condition ? session_cdo : na, "CDO", color=c_cdo_final, linewidth=1)
p_hg  = plot(display_condition ? session_hg : na, "Half Gap", color=c_hg_final, style=plot.style_stepline, linewidth=2)

// Zone Fill
c_fill_base = session_gap_dir == 1 ? color_fill_up : (session_gap_dir == -1 ? color_fill_dn : color_fill_fl)
// If session is exhausted, dim the zone (95% transparent)
c_fill_state = zone_state == "EXHAUSTED" ? color.new(c_fill_base, 95) : c_fill_base

// Fix: Prevent opaque fill when transp_val is 0. Only apply 100% transparency on the break bar.
fill_color_final = break_lines and is_start_bar ? color.new(c_fill_state, 100) : c_fill_state
fill(p_pdc, p_cdo, display_condition ? fill_color_final : na, "Redistribution Zone")

// Half Gap Highlight Zone
hg_top = session_hg * (1 + opt_zone)
hg_bot = session_hg * (1 - opt_zone)
should_plot_zones = show_zones and display_condition

// We use the same transparency logic for the HG zone lines
p_hg_top = plot(should_plot_zones ? hg_top : na, display=display.none)
p_hg_bot = plot(should_plot_zones ? hg_bot : na, display=display.none)

// Fix: Correct transparency logic for HG zone
hg_fill_color = break_lines and is_start_bar ? color.new(color_hg, 100) : color.new(color_hg, 92)
fill(p_hg_top, p_hg_bot, should_plot_zones ? hg_fill_color : na, "Half Gap Zone")

// Labels (Staggered horizontally for no overlap)
if show_labels and display_condition and barstate.islast
    label.new(bar_index + label_offset_input, session_pdc, "PDC: " + str.tostring(session_pdc, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=c_pdc_final, textalign=text.align_left, size=size.small)
    label.new(bar_index + label_offset_input + 4, session_cdo, "Open: " + str.tostring(session_cdo, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=c_cdo_final, textalign=text.align_left, size=size.small)
    label.new(bar_index + label_offset_input + 8, session_hg, "Half Gap: " + str.tostring(session_hg, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=c_hg_final, textalign=text.align_left, size=size.normal)

// =============================================================================
// 7. DASHBOARD & ALERTS
// =============================================================================

var table info_table = table.new(position.bottom_right, 2, 6, bgcolor=color.new(color.black, 50), border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)

if show_table and barstate.islast and display_condition
    // Row 0: Asset
    table.cell(info_table, 0, 0, "Asset", text_color=color.gray, text_halign=text.align_left, text_size=size.small)
    table.cell(info_table, 1, 0, current_asset_type, text_color=color.white, text_halign=text.align_right, text_size=size.small)
    // Row 1: Bias
    table.cell(info_table, 0, 1, "Bias", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 1, signal_bias, text_color=signal_bias=="LONG SCALP" or signal_bias=="BULLISH BREAKOUT" or signal_bias=="BULLISH TREND" ? color.green : (signal_bias=="SHORT SCALP" or signal_bias=="BEARISH BREAKDOWN" or signal_bias=="BEARISH TREND" ? color.red : color.gray), text_halign=text.align_right)
    // Row 2: Target
    table.cell(info_table, 0, 2, "Target", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 2, not na(signal_target) ? str.tostring(signal_target, format.mintick) : "—", text_color=color.white, text_halign=text.align_right)
    // Row 3: Mode
    mode_text = zone_state == "ACTIVE" ? "ACTIVE" : (zone_state == "TRENDING" ? "TRENDING" : "EXHAUSTED")
    mode_color = zone_state == "ACTIVE" ? color.green : (zone_state == "TRENDING" ? color.blue : color.orange)
    table.cell(info_table, 0, 3, "Mode", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 3, mode_text, text_color=mode_color, text_halign=text.align_right)
    // Row 4: Resilience
    table.cell(info_table, 0, 4, "Resil.", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 4, res_bias_str, text_color=res_bias_val==1?color.green:(res_bias_val==-1?color.red:color.gray), text_halign=text.align_right)

// Alerts
alertcondition(ta.cross(close, session_hg), "Half Gap Cross", "Price crossed Half Gap")
alertcondition(zone_state == "EXHAUSTED" and zone_state[1] == "ACTIVE", "Zone Exhausted", "Zone switched to EXHAUSTED")

// Calculate target reached condition separately
target_reached_cond = not na(signal_target) and ((signal_bias == "LONG SCALP" and close >= signal_target) or (signal_bias == "SHORT SCALP" and close <= signal_target))
alertcondition(target_reached_cond, "Target Reached", "Target Reached")

// Target Plot
plot(display_condition and not na(signal_target) and bar_index >= session_start_bar ? signal_target : na, "Target", color=color.new(color.yellow, 50), style=plot.style_circles, linewidth=1, trackprice=true)
