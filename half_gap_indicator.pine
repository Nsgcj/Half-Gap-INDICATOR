//@version=5
indicator("Half Gap Liquidity Indicator [Multi-Asset]", overlay=true, shorttitle="Half Gap MA")

// =============================================================================
// 1. INPUTS
// =============================================================================

// --- Asset Type Detection ---
grp_asset = "Asset Configuration"
asset_type = input.string("Auto-Detect", "Asset Type", options=["Auto-Detect", "Stocks/ETF", "Forex", "Crypto", "Futures", "Gold/Metals"], group=grp_asset, tooltip="Auto-detect will attempt to identify asset type. Manual selection overrides.")

// --- Session Settings ---
grp_session = "Session Settings"
session_start = input.session("0930-1600", "Trading Session (NY Time)", group=grp_session, tooltip="For Stocks: 0930-1600 | Forex: 1700-1700 | Futures: varies by contract")
time_zone     = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "UTC"], group=grp_session)
use_reg_hours = input.bool(true, "Use Regular Hours Only", group=grp_session, tooltip="Filters logic to apply only within specified session. Disable for 24hr markets.")

// Custom daily reset time for 24hr markets
custom_reset_hour = input.int(17, "Daily Reset Hour (24hr markets)", minval=0, maxval=23, group=grp_session, tooltip="For Forex/Crypto: Hour when 'new day' starts (e.g., 17 = 5 PM NY rollover)")

// --- Visual Settings ---
grp_visual = "Visual Settings"
color_upper   = input.color(color.green, "Upper Boundary Color", group=grp_visual)
color_lower   = input.color(color.red, "Lower Boundary Color", group=grp_visual)
color_hg      = input.color(color.white, "Half Gap Color", group=grp_visual)
color_fill_up = input.color(color.new(color.green, 90), "Zone Fill (Bullish Gap)", group=grp_visual)
color_fill_dn = input.color(color.new(color.red, 90), "Zone Fill (Bearish Gap)", group=grp_visual)
color_fill_fl = input.color(color.new(color.gray, 90), "Zone Fill (Flat)", group=grp_visual)

show_labels   = input.bool(true, "Show Price Labels", group=grp_visual)
show_table    = input.bool(true, "Show Info Panel", group=grp_visual)
show_zones    = input.bool(true, "Show Half Gap Zone", group=grp_visual, tooltip="Highlight band around Half Gap")
zone_width    = input.float(0.15, "Half Gap Zone Width (%)", minval=0.05, maxval=1.0, step=0.05, group=grp_visual) / 100

// Line break behavior
break_lines   = input.bool(true, "Break Lines at Session Change", group=grp_visual, tooltip="If enabled, lines will restart each session instead of continuing")

// --- Calculation Settings ---
grp_calc = "Calculation Settings"
vol_len       = input.int(20, "Volume MA Length", minval=1, group=grp_calc)
tol_pct       = input.float(0.01, "Position Tolerance (%)", minval=0.0, step=0.01, group=grp_calc) / 100

// Minimum gap threshold to generate signals
min_gap_pct   = input.float(0.05, "Minimum Gap % for Signals", minval=0.0, step=0.05, group=grp_calc, tooltip="Gaps smaller than this % are considered FLAT (no signal)")

// =============================================================================
// 2. ASSET TYPE DETECTION
// =============================================================================

detect_asset_type() =>
    string detected = "Stocks/ETF" // default

    if asset_type != "Auto-Detect"
        detected := asset_type
    else
        // Auto-detection logic
        ticker = syminfo.ticker
        type = syminfo.type

        // Forex detection
        if type == "forex" or str.length(ticker) == 6
            detected := "Forex"
        // Crypto detection
        else if type == "crypto" or str.contains(ticker, "BTC") or str.contains(ticker, "ETH") or str.contains(ticker, "USDT")
            detected := "Crypto"
        // Futures detection
        else if type == "futures" or str.contains(ticker, "!")
            detected := "Futures"
        // Gold/Metals detection
        else if str.contains(ticker, "GC") or str.contains(ticker, "XAU") or ticker == "GOLD"
            detected := "Gold/Metals"
        // Default to stocks
        else
            detected := "Stocks/ETF"

    detected

current_asset_type = detect_asset_type()

// =============================================================================
// 3. SESSION & NEW DAY DETECTION (MULTI-ASSET)
// =============================================================================

// Function to detect new trading day based on asset type
detect_new_day(asset_type_param) =>
    bool new_day_flag = false

    if asset_type_param == "Forex" or asset_type_param == "Crypto"
        // 24-hour markets: use custom reset time
        current_hour = hour(time, time_zone)
        prev_hour = hour(time[1], time_zone)

        // New day when we cross the reset hour
        new_day_flag := current_hour == custom_reset_hour and prev_hour != custom_reset_hour

    else if asset_type_param == "Futures" or asset_type_param == "Gold/Metals"
        // Futures: detect settlement/rollover (typically 5 PM ET for most contracts)
        // Use custom reset hour
        current_hour = hour(time, time_zone)
        prev_hour = hour(time[1], time_zone)
        new_day_flag := current_hour == custom_reset_hour and prev_hour != custom_reset_hour

    else // Stocks/ETF
        // Standard daily bar change
        new_day_flag := ta.change(time("D")) != 0

    new_day_flag

is_new_day = detect_new_day(current_asset_type)

// Session detection
is_in_session(sess_str) =>
    not na(time(timeframe.period, sess_str, time_zone))

in_session = use_reg_hours ? is_in_session(session_start) : true

// =============================================================================
// 4. DATA ACQUISITION & CALCULATIONS
// =============================================================================

// Multi-asset compatible daily data retrieval
// Refactored to avoid calling request.security inside conditional blocks
get_daily_data() =>
    // We use standard daily timeframe for all assets
    // The "new day" logic handles the session resets, so fetching standard "D" data is sufficient and safe
    d_open_req = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_off)
    d_close_prev_req = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)

    [d_open_req, d_close_prev_req]

[cdo, pdc] = get_daily_data()

// Validate data quality
valid_data = not na(cdo) and not na(pdc) and cdo > 0 and pdc > 0

// Session-locked values (persist throughout the session, don't recalculate)
var float session_pdc = na
var float session_cdo = na
var float session_hg = na
var int session_start_bar = na
var int session_gap_dir = 0
var float session_upper_b = na
var float session_lower_b = na
var float session_gap_mag = na

// Lock values at session start
if is_new_day and valid_data
    session_pdc := pdc
    session_cdo := cdo
    session_hg := (pdc + cdo) / 2
    session_start_bar := bar_index

    // Calculate gap metrics
    session_gap_dir := cdo > pdc ? 1 : (cdo < pdc ? -1 : 0)
    session_upper_b := math.max(pdc, cdo)
    session_lower_b := math.min(pdc, cdo)
    session_gap_mag := math.abs(cdo - pdc)

// Initialize on first bar if needed
if na(session_pdc) and valid_data
    session_pdc := pdc
    session_cdo := cdo
    session_hg := (pdc + cdo) / 2
    session_start_bar := bar_index
    session_gap_dir := cdo > pdc ? 1 : (cdo < pdc ? -1 : 0)
    session_upper_b := math.max(pdc, cdo)
    session_lower_b := math.min(pdc, cdo)
    session_gap_mag := math.abs(cdo - pdc)

// Use session-locked values
half_gap = session_hg
gap_dir  = session_gap_dir
upper_b  = session_upper_b
lower_b  = session_lower_b
gap_mag  = session_gap_mag

// Calculate gap percentage
gap_pct = (gap_mag / session_pdc) * 100

// Override gap direction to FLAT if gap is too small
if gap_pct < min_gap_pct
    gap_dir := 0

// =============================================================================
// 5. POSITION STATE & SIGNAL LOGIC
// =============================================================================

// Position State
hg_tolerance = half_gap * tol_pct
var int pos_state = 0 // 0=AT, 1=ABOVE, -1=BELOW

if not na(half_gap)
    if close > (half_gap + hg_tolerance)
        pos_state := 1
    else if close < (half_gap - hg_tolerance)
        pos_state := -1
    else
        pos_state := 0

// Momentum Logic
is_bull_mom = (close > open) and (close > close[1])
is_bear_mom = (close < open) and (close < close[1])

// Volume Logic
vol_sma = ta.sma(volume, vol_len)
is_high_vol = volume > vol_sma

// Time Held Counter
var int state_counter = 0
if pos_state == 1
    state_counter := pos_state[1] == 1 ? state_counter + 1 : 1
else if pos_state == -1
    state_counter := pos_state[1] == -1 ? state_counter + 1 : 1
else
    state_counter := 0

// Reset counter on new session
if is_new_day
    state_counter := 0

// Signal Generation
var string signal_bias = "NEUTRAL"
var float signal_target = na
var string conf_level = "LOW"

if gap_dir == -1 // Gap Down
    if pos_state == 1 // Above HG
        signal_bias := "BULLISH"
        signal_target := session_pdc
    else if pos_state == -1 // Below HG
        signal_bias := "BEARISH"
        signal_target := session_cdo
    else
        signal_bias := "NEUTRAL"
        signal_target := na
else if gap_dir == 1 // Gap Up
    if pos_state == 1 // Above HG
        signal_bias := "BULLISH"
        signal_target := session_cdo
    else if pos_state == -1 // Below HG
        signal_bias := "BEARISH"
        signal_target := session_pdc
    else
        signal_bias := "NEUTRAL"
        signal_target := na
else // Flat
    signal_bias := "NEUTRAL"
    signal_target := na

// Confidence Scoring
score = 0
if is_high_vol
    score := score + 1

if (signal_bias == "BULLISH" and is_bull_mom) or (signal_bias == "BEARISH" and is_bear_mom)
    score := score + 1

if state_counter > 5
    score := score + 1

if score >= 3
    conf_level := "HIGH"
else if score >= 2
    conf_level := "MEDIUM"
else
    conf_level := "LOW"

if signal_bias == "NEUTRAL"
    conf_level := "N/A"

// =============================================================================
// 6. VISUALIZATION - BREAKING LINES
// =============================================================================

// Determine if we should display (in session AND valid data)
display_condition = (use_reg_hours ? in_session : true) and not na(session_pdc)

// For breaking lines: only show current session's data
// We'll use plotted values that become 'na' on new session
float pdc_plot = na
float cdo_plot = na
float hg_plot = na

if display_condition
    if break_lines
        // Only plot if we're in current session (after session_start_bar)
        if bar_index >= session_start_bar
            pdc_plot := session_pdc
            cdo_plot := session_cdo
            hg_plot := session_hg
    else
        // Continuous lines (old behavior)
        pdc_plot := session_pdc
        cdo_plot := session_cdo
        hg_plot := session_hg

// Colors Logic
c_pdc_line = session_pdc == upper_b ? color_upper : color_lower
c_cdo_line = session_cdo == upper_b ? color_upper : color_lower

// Line Break Logic Refinement
// To ensure lines don't drag across sessions, we force 'na' on the very first bar of the session if break_lines is true.
// This ensures plot() has a gap to respect.
is_session_start = bar_index == session_start_bar
plot_pdc = break_lines and is_session_start ? na : pdc_plot
plot_cdo = break_lines and is_session_start ? na : cdo_plot
plot_hg  = break_lines and is_session_start ? na : hg_plot

// Plot Lines using style_linebr to respect NA values as breaks
p_pdc = plot(plot_pdc, "PDC", color=c_pdc_line, style=plot.style_linebr, linewidth=1, trackprice=false)
p_cdo = plot(plot_cdo, "CDO", color=c_cdo_line, style=plot.style_linebr, linewidth=1, trackprice=false)

// Half Gap - slightly thicker and use stepline for distinction (stepline handles breaks well usually, but linebr is safer for explicit breaks)
p_hg = plot(plot_hg, "Half Gap", color=color_hg, style=plot.style_linebr, linewidth=2, trackprice=false)

// Zone Fill (Redistribution Zone between PDC and CDO)
// Ensure fill respects the break by using the broken plot variables
// Note: fill() between two linebr plots will also break if one of them is na
c_fill = gap_dir == 1 ? color_fill_up : (gap_dir == -1 ? color_fill_dn : color_fill_fl)
fill(p_pdc, p_cdo, display_condition ? c_fill : na, "Redistribution Zone")

// Half Gap Highlight Zone
// Move logic outside of local scope to fix "Cannot use 'plot' in local scope" error
hg_top = session_hg * (1 + zone_width)
hg_bot = session_hg * (1 - zone_width)

// Determine if we should plot based on conditions
should_plot_zones = show_zones and display_condition

// Calculate plot values (na if not showing)
hg_top_val = should_plot_zones ? (break_lines and bar_index >= session_start_bar ? hg_top : (not break_lines ? hg_top : na)) : na
hg_bot_val = should_plot_zones ? (break_lines and bar_index >= session_start_bar ? hg_bot : (not break_lines ? hg_bot : na)) : na

// Plot calls must be in global scope
p_hg_top = plot(hg_top_val, display=display.none, trackprice=false)
p_hg_bot = plot(hg_bot_val, display=display.none, trackprice=false)

// Fill must be in global scope
fill(p_hg_top, p_hg_bot, should_plot_zones ? color.new(color_hg, 92) : na, "Half Gap Zone")

// Labels (Only show on the last bar to avoid clutter)
if show_labels and display_condition and barstate.islast
    label.new(bar_index, session_pdc, "PDC: " + str.tostring(session_pdc, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=c_pdc_line, textalign=text.align_left, size=size.small)
    label.new(bar_index, session_cdo, "Open: " + str.tostring(session_cdo, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=c_cdo_line, textalign=text.align_left, size=size.small)
    label.new(bar_index, session_hg, "Half Gap: " + str.tostring(session_hg, format.mintick), color=color.new(color.black, 100), style=label.style_none, textcolor=color_hg, textalign=text.align_left, size=size.normal)

// =============================================================================
// 7. INFO DASHBOARD
// =============================================================================

var table info_table = table.new(position.bottom_right, 2, 6, bgcolor=color.new(color.black, 50), border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)

if show_table and barstate.islast and display_condition
    // Row 0: Asset Type
    table.cell(info_table, 0, 0, "Asset", text_color=color.gray, text_halign=text.align_left, text_size=size.small)
    table.cell(info_table, 1, 0, current_asset_type, text_color=color.white, text_halign=text.align_right, text_size=size.small)

    // Row 1: Bias
    table.cell(info_table, 0, 1, "Bias", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 1, signal_bias, text_color=signal_bias=="BULLISH" ? color.green : (signal_bias=="BEARISH" ? color.red : color.gray), text_halign=text.align_right)

    // Row 2: Target
    table.cell(info_table, 0, 2, "Target", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 2, not na(signal_target) ? str.tostring(signal_target, format.mintick) : "—", text_color=color.white, text_halign=text.align_right)

    // Row 3: Confidence
    table.cell(info_table, 0, 3, "Conf", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 3, conf_level, text_color=conf_level=="HIGH" ? color.green : (conf_level=="MEDIUM" ? color.orange : color.gray), text_halign=text.align_right)

    // Row 4: Gap Direction & Size
    gap_display = (gap_dir==1 ? "UP " : (gap_dir==-1 ? "DN " : "FLAT ")) + str.tostring(gap_pct, "#.##") + "%"
    table.cell(info_table, 0, 4, "Gap", text_color=color.white, text_halign=text.align_left)
    table.cell(info_table, 1, 4, gap_display, text_color=color.white, text_halign=text.align_right)

    // Row 5: Position State
    pos_text = pos_state == 1 ? "ABOVE HG" : (pos_state == -1 ? "BELOW HG" : "AT HG")
    pos_color = pos_state == 1 ? color.green : (pos_state == -1 ? color.red : color.gray)
    table.cell(info_table, 0, 5, "Position", text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(info_table, 1, 5, pos_text, text_color=pos_color, text_halign=text.align_right, text_size=size.small)

// =============================================================================
// 8. ALERTS
// =============================================================================

// Alert conditions
alertcondition(ta.cross(close, half_gap), "Half Gap Cross", "Price crossed Half Gap at {{close}}")
alertcondition(ta.crossover(close, half_gap), "Half Gap Bullish Cross", "Price crossed ABOVE Half Gap - Potential Bullish")
alertcondition(ta.crossunder(close, half_gap), "Half Gap Bearish Cross", "Price crossed BELOW Half Gap - Potential Bearish")
alertcondition(signal_bias == "BULLISH" and conf_level == "HIGH" and signal_bias[1] != "BULLISH", "High Confidence Bullish", "HIGH confidence BULLISH signal generated")
alertcondition(signal_bias == "BEARISH" and conf_level == "HIGH" and signal_bias[1] != "BEARISH", "High Confidence Bearish", "HIGH confidence BEARISH signal generated")

// Target reached alerts
target_reached = not na(signal_target) and ((signal_bias == "BULLISH" and close >= signal_target) or (signal_bias == "BEARISH" and close <= signal_target))

alertcondition(target_reached, "Target Reached", "Price reached target level: {{close}}")

// =============================================================================
// 9. VISUAL ENHANCEMENTS
// =============================================================================

// Background color based on position state (subtle)
bgcolor_pos = pos_state == 1 ? color.new(color.green, 98) : (pos_state == -1 ? color.new(color.red, 98) : na)
bgcolor(display_condition ? bgcolor_pos : na, title="Position State Background")

// Plot target level as dotted line
plot(display_condition and not na(signal_target) and bar_index >= session_start_bar ? signal_target : na, "Target", color=color.new(color.yellow, 50), style=plot.style_circles, linewidth=1, trackprice=true)
